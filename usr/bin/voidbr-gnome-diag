#!/usr/bin/env bash
# voidbr-gnome-diag - mede o tempo do login do GNOME e liga/desliga as extensões
#
# Copyright (c) 2026, Vilmar Catafesta <vcatafesta@gmail.com>
# Copyright (c) 2026, VoidLinuxBR Team
# SPDX-License-Identifier: MIT
#
# Uso:
#   voidbr-gnome-diag            mostra o tempo do último login
#   voidbr-gnome-diag sem        desliga todas as extensões (vale no próximo login)
#   voidbr-gnome-diag com        religa as extensões (vale no próximo login)

log="${HOME}/.local/share/sddm/wayland-session.log"

if [ -t 1 ]; then
	green=$'\e[1;32m'
	yellow=$'\e[1;33m'
	red=$'\e[1;31m'
	cyan=$'\e[1;36m'
	reset=$'\e[0m'
else
	green='' yellow='' red='' cyan='' reset=''
fi

# hora "HH:MM:SS.mmm" da primeira linha do log que casa com o padrão
hora_no_log() {
	grep -m1 -E "$1" "$log" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+' | head -n1
}

# segundos (com fração) desde a meia-noite
segundos() {
	local h m s
	IFS=: read -r h m s <<<"$1"
	awk -v h="$h" -v m="$m" -v s="$s" 'BEGIN { printf "%.3f", h * 3600 + m * 60 + s }'
}

tempo() {
	if [ ! -r "$log" ]; then
		echo "${red}Log não encontrado:${reset} $log"
		exit 1
	fi

	local inicio shell pronto
	inicio=$(stat -c '%w' "$log" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}')
	shell=$(hora_no_log 'Running GNOME Shell')
	pronto=$(grep -m1 'GNOME Shell started' "$log" | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+' | head -n1)

	if [ -z "$inicio" ] || [ -z "$shell" ] || [ -z "$pronto" ]; then
		echo "${red}Não achei os horários no log.${reset} Faça login de novo e rode outra vez."
		exit 1
	fi

	local t0 t1 t2
	t0=$(segundos "$inicio")
	t1=$(segundos "$shell")
	t2=$(segundos "$pronto")

	echo "${cyan}Último login${reset}"
	printf '  sessão aberta pelo SDDM ... %s\n' "$inicio"
	printf '  GNOME Shell iniciando ..... %s  (+%.1f s)\n' "$shell" "$(awk -v a="$t1" -v b="$t0" 'BEGIN { print a - b }')"
	printf '  área de trabalho pronta ... %s  (+%.1f s)\n' "$pronto" "$(awk -v a="$t2" -v b="$t1" 'BEGIN { print a - b }')"
	printf '  %stotal: %.1f s%s\n' "$green" "$(awk -v a="$t2" -v b="$t0" 'BEGIN { print a - b }')" "$reset"

	if [ "$(gsettings get org.gnome.shell disable-user-extensions)" = "true" ]; then
		echo "  extensões: ${yellow}desligadas${reset}"
	else
		echo "  extensões: ligadas"
	fi
}

case "${1:-}" in
	"" | tempo)
		tempo
		;;
	sem)
		gsettings set org.gnome.shell disable-user-extensions true
		echo "Extensões ${yellow}desligadas${reset}. Saia e entre na sessão, depois rode: voidbr-gnome-diag"
		;;
	com)
		gsettings reset org.gnome.shell disable-user-extensions
		echo "Extensões ${green}religadas${reset}. Saia e entre na sessão, depois rode: voidbr-gnome-diag"
		;;
	*)
		echo "Uso: voidbr-gnome-diag [tempo|sem|com]"
		exit 1
		;;
esac
