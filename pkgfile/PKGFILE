#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=voidbr-gnome-config
pkgdesc="Skel config for VoidBR GNOME Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=()
backup=()

package() {
  # Verify default folder
  if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
    InternalDir="${srcdir}/${pkgname}/${pkgname}"
  elif [ -d "${srcdir}/${pkgname}" ]; then
    InternalDir="${srcdir}/${pkgname}"
  else
    #local
    InternalDir="${WORKDIR}"
  fi

  cd "${InternalDir}"
  # Copiar a estrutura de /etc, /usr e /opt para /
  local dirs=("boot" "etc" "opt" "usr" "var")
  for dir in "${dirs[@]}"; do
    if [ -d "${InternalDir}/${dir}" ]; then
      cp -a "${InternalDir}/${dir}" "${pkgdir}/"
    fi
  done

  # Install license file if present
  [ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # Install documentation if present
  [ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
  if [ "${update:-}" = "yes" ]; then
    log "Finalizando upgrade"
  else
    log "Finalizando instalação"
  fi

  # Ativa os padrões do /usr/share/glib-2.0/schemas/90_voidbr-gnome.gschema.override
  log "Compilando schemas do GSettings"
  glib-compile-schemas /usr/share/glib-2.0/schemas || true

  # Categorias da grade: a pasta VoidBR leva os apps chili-*, voidbr-* e org.voidbr.*
  # instalados agora, e as outras pastas não mostram esses apps (sem repetir)
  log "Gerando a lista de apps da categoria VoidBR"
  local f c lista=""
  for f in /usr/share/applications/chili-*.desktop /usr/share/applications/voidbr-*.desktop \
    /usr/share/applications/org.voidbr.*.desktop; do
    [ -e "$f" ] && lista="$lista'${f##*/}', "
  done
  if [ -n "$lista" ]; then
    lista="[${lista%, }]"
  else
    lista="@as []"
  fi
  {
    echo "# Gerado pelo post_install do voidbr-gnome-config (não editar)"
    echo "[org/gnome/desktop/app-folders/folders/voidbr-voidbr]"
    echo "apps=$lista"
    for c in internet escritorio graficos multimidia desenvolvimento jogos utilitarios sistema; do
      echo
      echo "[org/gnome/desktop/app-folders/folders/voidbr-$c]"
      echo "excluded-apps=$lista"
    done
  } >/etc/dconf/db/local.d/20-voidbr-gnome-apps

  # Padrões do dconf (/etc/dconf/db/local.d): GSConnect e mosaico do Forge desligados,
  # categorias da grade de apps
  log "Atualizando o banco do dconf"
  dconf update || true

  # Build da ISO e instalador: o skel vai para o usuário criado depois
  if [ -n "${MKISO_BUILD:-}" ] || [ -n "${VOIDBR_INSTALLER:-}" ]; then
    return 0
  fi

  # Cópia do skel (/etc/skel) para o usuário que está instalando/atualizando
  [ -n "${user:-}" ] || return 0
  if [ ! -x /usr/local/bin/voidbr-copy-skel-inc ]; then
    log "voidbr-copy-skel-inc nao encontrado: skel nao copiado"
    return 0
  fi

  local resp="t" prompt

  # Instalação nova: copia tudo (o que for diferente vai para backup).
  # Atualização: pergunta, se houver terminal. Sem terminal, ou sem
  # resposta em 30s, não altera nada do que o usuário já tem.
  if [ "${update:-}" = "yes" ]; then
    resp=""
    # O xbps roda este script com /bin/sh (dash), que não tem
    # "read -t/-p"; a pergunta com tempo limite vai pelo bash,
    # lendo direto do terminal. Prefixo no mesmo formato do log().
    if [ -t 1 ] && { : </dev/tty; } 2>/dev/null; then
      # Pergunta em branco, teclas em amarelo (destaca das linhas do log)
      prompt=$(printf '%s[*]%s %s - %s' "$CYAN" "${BLACK}$pkgname" "${RST}" "${WHITE}")
      prompt="${prompt}Configurações de $user: aplicar [${YELLOW}t${WHITE}]odas (com backup) ou só as [${YELLOW}N${WHITE}]ovas? ${RESET}"
      resp=$(bash -c 'read -r -t 30 -p "$1" r </dev/tty >&2 || echo >&2; printf "%s" "$r"' _ "$prompt") || true
    fi
  fi

  case "$resp" in
    t | T | todas | Todas | TODAS)
      # Substitui o que for diferente, com backup em ~/.voidbr-skel-backup-*
      log "Aplicando configuracoes padrao para $user"
      /usr/local/bin/voidbr-copy-skel-inc --user "$user" --force --quiet || true
      ;;
    *)
      # Copia só o que ainda não existe no HOME
      log "Aplicando novas configuracoes para $user"
      /usr/local/bin/voidbr-copy-skel-inc --user "$user" --only-new --quiet || true
      ;;
  esac
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}

post_remove() {
	rm -f /etc/dconf/db/local.d/20-voidbr-gnome-apps
	dconf update || true
}
